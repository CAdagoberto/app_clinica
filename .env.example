# O app está em modo mock (`src/data/mockApi.js` via `clinicaApi.js`).
# Não é necessário subir o servidor Express nem definir EXPO_PUBLIC_API_URL.
#
# Quando a API voltar, restaure o `clinicaApi.js` REST e use, por exemplo:
# EXPO_PUBLIC_API_URL=https://visaoderuastore.com.br
# EXPO_PUBLIC_API_URL=http://127.0.0.1:4000

# Data de referência do mock (consultas do dia, alertas, notificações)
EXPO_PUBLIC_DATA_REFERENCIA=2026-04-20
